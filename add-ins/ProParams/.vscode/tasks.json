{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Deps",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}/client",
        "statusbar": {
          "hide": false,
          "color": "#8fbce1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Start",
      "type": "shell",
      "command": "pnpm start",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/client",
        "statusbar": {
          "hide": false,
          "color": "#cef413"
        }
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/client",
        "statusbar": {
          "hide": false,
          "color": "#c49816"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
  ]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Deps for All",
      "type": "shell",
      "command": "call \"${workspaceFolder}\\.vscode\\install_all_dependencies.bat\"",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        },
        "statusbar": {
          "hide": false,
          "color": "#8fbce1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Build All Add-Ins",
      "type": "shell",
      "command": "call \"${workspaceFolder}\\.vscode\\build_all_addins.bat\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        },
        "statusbar": {
          "hide": false,
          "color": "#c49816"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },

  ]
}

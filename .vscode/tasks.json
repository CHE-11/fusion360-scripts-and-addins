{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Deps for All",
      "type": "shell",
      "command": "call \"${workspaceFolder}\\add-ins\\CONstrainer\\scripts\\install_dependencies.bat\" && call \"${workspaceFolder}\\add-ins\\FileExplorer\\scripts\\install_dependencies.bat\" && call \"${workspaceFolder}\\add-ins\\ProParams\\scripts\\install_dependencies.bat\" && call \"${workspaceFolder}\\add-ins\\RestartAddIns\\scripts\\install_dependencies.bat\" && call \"${workspaceFolder}\\add-ins\\ScriptRunner\\scripts\\install_dependencies.bat\"",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        },
        "statusbar": {
          "hide": false,
          "color": "#8fbce1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Build All Add-Ins",
      "type": "shell",
      "command": "call \"${workspaceFolder}\\add-ins\\CONstrainer\\scripts\\build_add_in.bat\" && call \"${workspaceFolder}\\add-ins\\FileExplorer\\scripts\\build_add_in.bat\" && call \"${workspaceFolder}\\add-ins\\ProParams\\scripts\\build_add_in.bat\" && call \"${workspaceFolder}\\add-ins\\RestartAddIns\\scripts\\build_add_in.bat\" && call \"${workspaceFolder}\\add-ins\\ScriptRunner\\scripts\\build_add_in.bat\"",
      "group": {
